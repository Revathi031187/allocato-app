# Bot Framework (required for Teams)
# Created when you create/register the bot in Azure
MICROSOFT_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_APP_PASSWORD=your-client-secret

# Local dev
PORT=3978
